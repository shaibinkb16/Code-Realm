# Production Environment Configuration Template
# Copy this file to .env and fill in your real values.
ENVIRONMENT=production
SECRET_KEY=your_secret_key_here

# Primary Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres.project_ref:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here

# Redis Cache Configuration (Upstash recommended for production)
REDIS_URL=rediss://default:your_password@your-host.upstash.io:6379
REDIS_HOST=your-host.upstash.io
REDIS_PORT=6379

# AI Provider API Keys & Fallbacks
AI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Sandboxed code execution. Only set to true if you are also running a
# separate `arq app.core.worker.WorkerSettings` process against this same
# Redis instance (see docker-compose.yml's `worker` service) — otherwise
# execution requests will time out waiting for a worker that isn't there.
EXECUTION_USE_SANDBOX=false

# SMTP Email Configuration (For OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=no-reply@your-domain.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

FRONTEND_URL=http://localhost:5173


